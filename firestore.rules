rules_version = '2';

// =====================================================================
// Firestore セキュリティルール
// =====================================================================
// 方針:
//   - 認証済み（＝運営者。現状ログインするのは運営者のみ）だけが全コレクションを直接読み書き可
//   - 未認証（＝参加者）は全拒否。公開情報の閲覧・予約・日程調整の回答は
//     Cloud Functions の窓口（Admin SDK でルールを迂回）経由でのみ行う
//   - これにより customers（顧客の個人情報）は参加者から一切到達できない
//
// ⚠️ デプロイのタイミング: このルールは段階 S4 で初めて deploy する。
//    それまでは Firebase コンソールのテストモードのまま（早期に deploy すると参加者画面が壊れる）。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
