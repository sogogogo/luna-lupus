rules_version = '2';

// =====================================================================
// Firestore セキュリティルール
// =====================================================================
// 方針:
//   - 運営者（admin カスタムクレーム）だけが全コレクションを直接読み書き可
//   - それ以外（参加者は Google ログイン＝認証済みだが admin クレーム無し／未認証）は全拒否
//   - 公開情報の閲覧・予約・回答などは Cloud Functions の窓口（Admin SDK でルールを迂回）経由のみ
//   - これにより customers（顧客の個人情報）は参加者から一切到達できない
//
// ⚠️ 重要: 参加者も Google ログインするため request.auth != null では不十分（参加者に全権限が渡る）。
//          必ず admin クレームで判定する。
// ⚠️ デプロイのタイミング: このルールは段階 S4 で立ち会いのうえ deploy する。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
