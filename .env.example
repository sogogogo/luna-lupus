# Firebase 設定の見本（キー名のみ・値は空）
# 使い方: このファイルを .env.local にコピーし、各値を Firebase コンソールの構成から記入する
#   Firebase コンソール → プロジェクトの設定 → マイアプリ（Web）の SDK 構成
# .env.local は Git に含めない（.gitignore 済み）。この .env.example はコミットしてよい。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
